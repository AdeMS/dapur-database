{
    "name": "adems/dapur-database",
    "description": "Modul database untuk Dapur AdeMS: memasang dan memperbarui tabel semua modul dengan satu perintah",
    "type": "library",
    "license": "BSD-3-Clause",
    "keywords": [
        "dapur",
        "adems",
        "laminas",
        "mezzio",
        "database",
        "skema"
    ],
    "homepage": "https://www.adems.id",
    "authors": [
        {
            "name": "Ade M Saragih",
            "homepage": "https://www.adems.id"
        }
    ],
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "composer-runtime-api": "^2.0",
        "laminas/laminas-db": "^2.22",
        "psr/container": "^1.1 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "AdeMS\\Dapur\\Database\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AdeMS\\Dapur\\Database\\Test\\": "test/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
